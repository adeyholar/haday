# HaDay — copy to .env on the host. Never commit real secrets.

# Public URL of THIS deploy (no trailing slash). Must match the address classmates open.
BETTER_AUTH_URL=https://hadayhebbraimentor.jcdisn.com
PUBLIC_APP_URL=https://hadayhebbraimentor.jcdisn.com

# Postgres 16 (Azure Flexible Server, or any other host).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/haday?sslmode=require

# Session signing. Long random string. Keep it stable across deploys of this host.
BETTER_AUTH_SECRET=

# Accounts on.
VITE_AUTH_ENABLED=true

# Container / Azure
HOST=0.0.0.0
PORT=8080
WEBSITES_PORT=8080

# Class roster owner emails (comma-separated). Crown is also recognized by name.
HADAY_ADMIN_EMAILS=talk2pastoradeolaade@yahoo.com,adeolaa@jcdisn.com

# Password-reset mail (first match wins): Resend, then SendGrid, then SMTP.
RESEND_API_KEY=
# SENDGRID_API_KEY=
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=
MAIL_FROM=HaDay <noreply@your-domain>

# Google / X sign-in (Grok broker). Set on the host if classmates use those buttons.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
