# HaDay — copy to .env on the host. Never commit real secrets.

# Public URL of THIS deploy (no trailing slash). Must match the address classmates open.
BETTER_AUTH_URL=https://hebrewmentor.haday.app
PUBLIC_APP_URL=https://hebrewmentor.haday.app

# Postgres 16 (Azure Flexible Server, or any other host).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/haday?sslmode=require

# Session signing. Long random string. Keep it stable across deploys of this host.
BETTER_AUTH_SECRET=

# Accounts on.
VITE_AUTH_ENABLED=true

# Container / Azure
HOST=0.0.0.0
PORT=8080
WEBSITES_PORT=8080

# Class roster owner emails (comma-separated). A display name does not count.
HADAY_ADMIN_EMAILS=talk2pastoradeolaade@yahoo.com,adeolaa@jcdisn.com,adeyholar@aol.com

# Password-reset mail (first match wins): Resend, then SendGrid, then SMTP.
RESEND_API_KEY=
# SENDGRID_API_KEY=
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=
MAIL_FROM=HaDay <noreply@your-domain>

# Google sign-in. Both must be set or the Google button stays off.
# No preview client is used when these are empty.
# Callback to register at Google: https://hebrewmentor.haday.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X sign-in. Both must be set or the X button stays off.
# No preview client and no broker. Callback to register in the X app:
# https://hebrewmentor.haday.app/api/auth/callback/twitter
X_CLIENT_ID=
X_CLIENT_SECRET=
